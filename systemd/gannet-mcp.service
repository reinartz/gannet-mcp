[Unit]
Description=Web Search MCP Server (HTTP mode)
Documentation=https://github.com/reinartz/gannet-mcp
After=network.target

[Service]
Type=simple

# Run as unprivileged user (created via systemd-sysusers drop-in)
User=gannet-mcp
Group=gannet-mcp

# Environment - loaded from drop-in config file
EnvironmentFile=/etc/gannet-mcp.conf

# NOTE: the `service run` subcommand will be implemented in Phase 1;
# until then this ExecStart will fail. All config via EnvironmentFile.
ExecStart=/usr/bin/gannet-mcp service run

# Restart policy
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/gannet-mcp

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
