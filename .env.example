# Web Search MCP Server Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# Logging Configuration
# =============================================================================

# Log level: trace, debug, info, warn, error
MCP__LOGGING__LEVEL=info

# Log format: pretty, json, compact
MCP__LOGGING__FORMAT=pretty

# Include timestamps in log output
MCP__LOGGING__INCLUDE_TIMESTAMPS=true

# =============================================================================
# Search Configuration
# =============================================================================

# Search provider: duckduckgo, serper, searxng, brightdata
MCP__SEARCH__PROVIDER=duckduckgo

# API key for search provider (required by brightdata, serper)
# MCP__SEARCH__API_KEY=your_api_key

# Search engine ID (Bright Data SERP zone, e.g. serp_api1)
# MCP__SEARCH__SEARCH_ENGINE_ID=your_search_engine_id

# Base URL for custom search API (optional — used by SearXNG)
# MCP__SEARCH__BASE_URL=http://127.0.0.1:8888

# Default number of results
MCP__SEARCH__DEFAULT_LIMIT=10

# Maximum results per query
MCP__SEARCH__MAX_LIMIT=100

# Search request timeout in seconds
MCP__SEARCH__TIMEOUT_SECS=10

# =============================================================================
# Rate Limiting Configuration
# =============================================================================

# Enable rate limiting
MCP__RATE_LIMIT__ENABLED=true

# Maximum requests per minute
MCP__RATE_LIMIT__REQUESTS_PER_MINUTE=60

# Maximum concurrent requests
MCP__RATE_LIMIT__MAX_CONCURRENT=10

# Burst size for token bucket
MCP__RATE_LIMIT__BURST_SIZE=5

# =============================================================================
# Server Configuration
# =============================================================================

# Host to bind to
MCP__SERVER__HOST=127.0.0.1

# Port to listen on (for TCP mode)
MCP__SERVER__PORT=8080

# Use STDIO transport (recommended for MCP)
MCP__SERVER__USE_STDIO=true

# Path to socket file (for socket mode)
# MCP__SERVER__SOCKET_PATH=/tmp/mcp-server.sock

# =============================================================================
# HTTP Server Configuration (Streamable HTTP transport mode)
# =============================================================================

# URL path for MCP endpoint (default: /mcp)
# MCP__SERVER__HTTP__PATH=/mcp

# SSE keep-alive interval in seconds (default: 30)
# MCP__SERVER__HTTP__SSE_KEEP_ALIVE_SECS=30

# Prefer JSON responses for simple request-response (default: true)
# MCP__SERVER__HTTP__JSON_RESPONSE=true

# Allowed hosts for inbound Host header validation (comma-separated)
# MCP__SERVER__HTTP__ALLOWED_HOSTS=localhost,127.0.0.1

# CORS allowed origin (default: "*" = allow all origins)
# Set to a specific origin like "https://myapp.example.com" for production use
# MCP__SERVER__HTTP__CORS_ORIGIN=*

# Legacy session mode for compatibility with clients that don't track Mcp-Session-Id
# MCP__SERVER__HTTP__LEGACY_SESSION_MODE=false